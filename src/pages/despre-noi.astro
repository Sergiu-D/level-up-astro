---
import Layout from '../layouts/Layout.astro';
import aboutData from '../data/about.json';
import { loadDataWithVariables } from '../utils/variables.js';
import Header from '../components/Header.astro';
import ContactCTA from '../components/ContactCTA.astro';

const processedData = loadDataWithVariables(aboutData) as any;
---

<Layout title="Despre Noi">
  <!-- Hero Section with Image Background -->
  <div class="relative">
    <div class="absolute inset-0 z-0">
      <div class="w-full h-full bg-gradient-to-r from-blue-900/90 to-indigo-900/90"></div>
      <div class="absolute inset-0 bg-[url('/img/about-hero.jpg')] bg-cover bg-center mix-blend-overlay opacity-70"></div>
    </div>
    
    <div class="relative z-10 pt-24 pb-20 md:pt-32 md:pb-28">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">{processedData.header.title}</h1>
          <p class="text-xl text-blue-100 mb-8">{processedData.header.description}</p>
          <div class="w-24 h-1 bg-gradient-to-r from-blue-400 to-indigo-400 mx-auto"></div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="container mx-auto px-4 py-16">
    <!-- Introduction Section -->
    <section id="antet" class="mb-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div class="order-2 lg:order-1">
          <h2 class="text-3xl font-bold text-primary-800 mb-6">Povestea Noastră</h2>
          <div class="w-20 h-1 bg-gradient-to-r from-blue-600 to-indigo-700 mb-8"></div>
          <div class="prose prose-lg max-w-none text-gray-700">
            <p class="mb-4">{processedData.story.paragraphs[0]}</p>
            <p>{processedData.story.paragraphs[1]}</p>
          </div>
        </div>
        <div class="order-1 lg:order-2">
          <div class="relative">
            <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-xl">
              <img src="/img/campus.jpg" alt="Centrul nostru" class="w-full h-full object-cover" />
            </div>
            <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-gradient-to-br from-blue-600 to-indigo-700 rounded-xl -z-10"></div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- About Section -->
    <section id="despre" class="mb-24">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-primary-800 mb-4">Abordarea Noastră</h2>
        <div class="w-24 h-1 bg-gradient-to-r from-blue-600 to-indigo-700 mx-auto mb-8"></div>
        <p class="max-w-3xl mx-auto text-xl text-gray-700">{processedData.approach.description}</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <div class="bg-white rounded-xl shadow-lg overflow-hidden transform transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
          <div class="h-48 bg-[url('/img/methodology-1.jpg')] bg-cover bg-center"></div>
          <div class="p-6">
            <h3 class="text-xl font-semibold text-primary-700 mb-4">Comunicare</h3>
            <p class="text-gray-700 mb-4">Învățarea limbii engleze prin conversație și practică reală, nu doar prin teorie.</p>
            <div class="flex items-center text-primary-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L9 9.414V13a1 1 0 102 0V9.414l1.293 1.293a1 1 0 001.414-1.414z" clip-rule="evenodd" />
              </svg>
              <span class="font-medium">Accent pe exprimare</span>
            </div>
          </div>
        </div>
        
        <div class="bg-white rounded-xl shadow-lg overflow-hidden transform transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
          <div class="h-48 bg-[url('/img/methodology-2.jpg')] bg-cover bg-center"></div>
          <div class="p-6">
            <h3 class="text-xl font-semibold text-primary-700 mb-4">Evaluare Continuă</h3>
            <p class="text-gray-700 mb-4">Feedback constant și evaluare pentru îmbunătățirea continuă a abilităților lingvistice.</p>
            <div class="flex items-center text-primary-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L9 9.414V13a1 1 0 102 0V9.414l1.293 1.293a1 1 0 001.414-1.414z" clip-rule="evenodd" />
              </svg>
              <span class="font-medium">Progres măsurabil</span>
            </div>
          </div>
        </div>
        
        <div class="bg-white rounded-xl shadow-lg overflow-hidden transform transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
          <div class="h-48 bg-[url('/img/methodology-3.jpg')] bg-cover bg-center"></div>
          <div class="p-6">
            <h3 class="text-xl font-semibold text-primary-700 mb-4">Materiale Autentice</h3>
            <p class="text-gray-700 mb-4">Utilizarea materialelor autentice din viața reală pentru un context practic de învățare.</p>
            <div class="flex items-center text-primary-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L9 9.414V13a1 1 0 102 0V9.414l1.293 1.293a1 1 0 001.414-1.414z" clip-rule="evenodd" />
              </svg>
              <span class="font-medium">Contexte reale</span>
            </div>
          </div>
        </div>
      </div>
      
      <div class="mt-16 bg-gradient-to-br from-blue-50 to-indigo-50 p-8 rounded-2xl shadow-lg border border-blue-100">
        <div class="flex flex-col md:flex-row items-center">
          <div class="md:w-1/3 mb-6 md:mb-0 md:pr-10">
            <img src="/img/cambridge-method.jpg" alt="Metodologia Cambridge" class="rounded-xl shadow-md w-full" />
          </div>
          <div class="md:w-2/3">
            <h3 class="text-2xl font-semibold text-primary-700 mb-4">{processedData.approach.methodology.title}</h3>
            <p class="text-gray-700 mb-6">{processedData.approach.methodology.description}</p>
            <ul class="space-y-3 text-gray-700">
              {processedData.approach.methodology.points.map((point: string) => (
                <li class="flex items-start">
                  <div class="flex-shrink-0 w-6 h-6 rounded-full bg-gradient-to-r from-blue-600 to-indigo-700 flex items-center justify-center mr-3 mt-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Facilities Section -->
    <section id="facilitati" class="mb-24">
      <div class="relative py-16 px-8 rounded-3xl overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-r from-blue-600 to-indigo-700 opacity-90"></div>
        <div class="absolute inset-0 bg-[url('/img/facilities-bg.jpg')] bg-cover bg-center mix-blend-overlay"></div>
        
        <div class="relative z-10 text-center mb-12">
          <h2 class="text-3xl font-bold text-white mb-4">{processedData.facilities.title}</h2>
          <div class="w-24 h-1 bg-white mx-auto mb-6"></div>
          <p class="max-w-3xl mx-auto text-xl text-blue-100">{processedData.facilities.description}</p>
        </div>
        
        <div class="relative z-10 grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white/95 backdrop-blur-sm p-8 rounded-xl shadow-lg text-center transform transition-all duration-300 hover:scale-105">
            <div class="w-20 h-20 mx-auto mb-6 bg-gradient-to-r from-blue-600 to-indigo-700 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-primary-700 mb-4">Săli Moderne</h3>
            <p class="text-gray-600">Săli de clasă dotate cu tehnologie modernă pentru o experiență educațională de calitate.</p>
            <img src="/img/classroom.jpg" alt="Săli de clasă moderne" class="w-full h-40 object-cover rounded-lg mt-6" />
          </div>
          
          <div class="bg-white/95 backdrop-blur-sm p-8 rounded-xl shadow-lg text-center transform transition-all duration-300 hover:scale-105">
            <div class="w-20 h-20 mx-auto mb-6 bg-gradient-to-r from-blue-600 to-indigo-700 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-primary-700 mb-4">Bibliotecă</h3>
            <p class="text-gray-600">Acces la o colecție bogată de materiale și resurse didactice în limba engleză.</p>
            <img src="/img/library.jpg" alt="Biblioteca noastră" class="w-full h-40 object-cover rounded-lg mt-6" />
          </div>
          
          <div class="bg-white/95 backdrop-blur-sm p-8 rounded-xl shadow-lg text-center transform transition-all duration-300 hover:scale-105">
            <div class="w-20 h-20 mx-auto mb-6 bg-gradient-to-r from-blue-600 to-indigo-700 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-primary-700 mb-4">Resurse Multimedia</h3>
            <p class="text-gray-600">Utilizarea tehnologiei moderne pentru o învățare interactivă și eficientă.</p>
            <img src="/img/multimedia.jpg" alt="Resurse multimedia" class="w-full h-40 object-cover rounded-lg mt-6" />
          </div>
        </div>
      </div>
    </section>
    
    <!-- Team Section -->
    <section id="echipa" class="mb-24">
      <div class="text-center mb-16">
        <span class="inline-block py-1 px-3 rounded-full bg-blue-100 text-primary-700 text-sm font-medium mb-3">Profesioniști în Educație</span>
        <h2 class="text-3xl font-bold text-primary-800 mb-4">{processedData.team.title}</h2>
        <div class="w-24 h-1 bg-gradient-to-r from-blue-600 to-indigo-700 mx-auto mb-8"></div>
        <p class="max-w-3xl mx-auto text-xl text-gray-700">Echipa noastră este formată din profesori calificați, dedicați excelenței în educație și dezvoltării personale a fiecărui student.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        {processedData.team.members.map((member: any, index: number) => (
          <div class="bg-white rounded-xl shadow-md overflow-hidden transform transition-all duration-300 hover:shadow-xl hover:-translate-y-2">
            <div class="h-64 bg-gradient-to-r from-blue-400 to-indigo-400 relative overflow-hidden">
              <img src={`/img/team-${index + 1}.jpg`} alt={member.name} class="w-full h-full object-cover mix-blend-overlay opacity-75" />
              <div class="absolute inset-0 bg-gradient-to-t from-blue-900/80 to-transparent"></div>
              <div class="absolute bottom-0 left-0 p-6 text-white">
                <h3 class="font-bold text-2xl">{member.name}</h3>
                <p class="text-blue-200">{member.position}</p>
              </div>
            </div>
            <div class="p-6">
              <p class="text-gray-700">{member.description}</p>
              <div class="mt-6 flex space-x-3">
                <a href="#" class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-primary-700 hover:bg-primary-700 hover:text-white transition-colors">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
                  </svg>
                </a>
                <a href="#" class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-primary-700 hover:bg-primary-700 hover:text-white transition-colors">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
                  </svg>
                </a>
                <a href="#" class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-primary-700 hover:bg-primary-700 hover:text-white transition-colors">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
    
    <!-- Statistics Section -->
    <section id="statistici" class="mb-24">
      <div class="relative py-20 px-8 rounded-3xl overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-r from-blue-900 to-indigo-900"></div>
        <div class="absolute inset-0 bg-[url('/img/pattern.svg')] bg-repeat opacity-10"></div>
        
        <div class="relative z-10 text-center mb-16">
          <span class="inline-block py-1 px-3 rounded-full bg-blue-800 text-blue-200 text-sm font-medium mb-3">Rezultate Remarcabile</span>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Performanța Noastră în Cifre</h2>
          <div class="w-24 h-1 bg-gradient-to-r from-blue-400 to-indigo-400 mx-auto"></div>
        </div>
        
        <div class="relative z-10">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
            <div class="group">
              <div class="bg-white/10 backdrop-blur-sm p-8 rounded-xl border border-white/20 text-center transform transition-all duration-500 group-hover:bg-white/20 group-hover:scale-105">
                <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-blue-700/50 flex items-center justify-center group-hover:bg-blue-600 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                </div>
                <div class="text-5xl font-bold text-white mb-3 flex justify-center">
                  <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-indigo-300">500+</span>
                </div>
                <p class="text-blue-200 text-lg">Studenți pe an</p>
              </div>
            </div>
            
            <div class="group">
              <div class="bg-white/10 backdrop-blur-sm p-8 rounded-xl border border-white/20 text-center transform transition-all duration-500 group-hover:bg-white/20 group-hover:scale-105">
                <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-blue-700/50 flex items-center justify-center group-hover:bg-blue-600 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                  </svg>
                </div>
                <div class="text-5xl font-bold text-white mb-3 flex justify-center">
                  <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-indigo-300">95%</span>
                </div>
                <p class="text-blue-200 text-lg">Rată de promovare</p>
              </div>
            </div>
            
            <div class="group">
              <div class="bg-white/10 backdrop-blur-sm p-8 rounded-xl border border-white/20 text-center transform transition-all duration-500 group-hover:bg-white/20 group-hover:scale-105">
                <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-blue-700/50 flex items-center justify-center group-hover:bg-blue-600 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div class="text-5xl font-bold text-white mb-3 flex justify-center">
                  <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-indigo-300">12</span>
                </div>
                <p class="text-blue-200 text-lg">Ani de experiență</p>
              </div>
            </div>
            
            <div class="group">
