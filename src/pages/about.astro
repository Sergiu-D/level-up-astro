---
import Layout from '../layouts/Layout.astro';
import aboutData from '../data/about.json';
import { loadDataWithVariables } from '../utils/variables.js';
import ContactCTA from '../sections/ContactCTA.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Badge from '../components/Badge.astro';
import AnimatedTimeline from '../components/AnimatedTimeline.astro';
import FunFactCard from '../components/FunFactCard.astro';
import TeamMemberCard from '../components/TeamMemberCard.astro';
import MethodologyCard from '../components/MethodologyCard.astro';

const processedData = loadDataWithVariables(aboutData) as any;
---

<Layout title="Despre noi | Cambridge English School">
  <!-- Hero Section with Animated Background -->
  <section class="relative py-20 overflow-hidden bg-gradient-to-b from-indigo-900 via-blue-800 to-indigo-900">
    <!-- Animated background elements -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-full opacity-20">
        <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
          <defs>
            <pattern id="smallGrid" width="20" height="20" patternUnits="userSpaceOnUse">
              <path d="M 20 0 L 0 0 0 20" fill="none" stroke="white" stroke-width="0.5" opacity="0.5"/>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#smallGrid)" />
        </svg>
      </div>

      <!-- Floating shapes -->
      <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-blue-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob"></div>
      <div class="absolute top-1/3 right-1/4 w-64 h-64 bg-purple-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-2000"></div>
      <div class="absolute bottom-1/4 right-1/3 w-64 h-64 bg-pink-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-4000"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10 text-center">
      <Badge text="Despre Noi" color="purple" animated={true} />
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 text-white">
        {processedData.header.title}
      </h1>
      <p class="text-xl text-blue-100 max-w-3xl mx-auto mb-10">
        {processedData.header.description}
      </p>

      <!-- Decorative elements -->
      <div class="flex justify-center space-x-4 mb-8">
        <div class="w-3 h-3 rounded-full bg-blue-400"></div>
        <div class="w-3 h-3 rounded-full bg-indigo-400"></div>
        <div class="w-3 h-3 rounded-full bg-purple-400"></div>
      </div>
    </div>
  </section>

  <!-- Our Story Timeline Section -->
  <section class="py-16 bg-gradient-to-b from-white to-blue-50">
    <div class="container mx-auto px-4">
      <SectionTitle
        title="Povestea Noastră"
        description="Descoperă cum a început călătoria noastră și cum am crescut de-a lungul anilor."
        badge="Istorie"
      />

      <div class="max-w-4xl mx-auto">
        <AnimatedTimeline items={[
          {
            year: '2010',
            title: 'Începutul călătoriei',
            description: processedData.story.paragraphs[0],
            icon: 'flag',
            color: 'blue'
          },
          {
            year: '2015',
            title: 'Extinderea programelor',
            description: 'Am extins programele noastre pentru a include mai multe niveluri și grupe de vârstă, adaptându-ne la nevoile comunității.',
            icon: 'book',
            color: 'purple'
          },
          {
            year: '2018',
            title: 'Centru autorizat Cambridge',
            description: 'Am devenit centru autorizat Cambridge, oferind pregătire și certificare pentru toate nivelurile.',
            icon: 'award',
            color: 'green'
          },
          {
            year: '2023',
            title: 'Prezent și viitor',
            description: processedData.story.paragraphs[1],
            icon: 'star',
            color: 'pink'
          }
        ]} />
      </div>
    </div>
  </section>

  <!-- Fun Facts Section -->
  <section class="py-16 bg-gradient-to-b from-blue-50 to-white">
    <div class="container mx-auto px-4">
      <SectionTitle
        title="Lucruri interesante despre noi"
        description="Câteva fapte distractive despre școala noastră și metodologia Cambridge."
        badge="Fun Facts"
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <FunFactCard
          title="Peste 1000 de absolvenți"
          fact="Mai mult de 1000 de elevi au absolvit programele noastre cu certificări Cambridge recunoscute internațional."
          icon="star"
          color="blue"
        />

        <FunFactCard
          title="Metodologie interactivă"
          fact="Folosim jocuri, activități și tehnologie modernă pentru a face învățarea limbii engleze distractivă și eficientă."
          icon="lightbulb"
          color="purple"
        />

        <FunFactCard
          title="Comunitate globală"
          fact="Elevii noștri fac parte dintr-o comunitate globală de peste 5 milioane de persoane care susțin examene Cambridge în fiecare an."
          icon="rocket"
          color="pink"
        />
      </div>
    </div>
  </section>

  <!-- Methodology Section -->
  <section class="py-16 bg-gradient-to-b from-white to-indigo-50">
    <div class="container mx-auto px-4">
      <SectionTitle
        title="Abordarea noastră"
        description={processedData.approach.description}
        badge="Metodologie"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
        <MethodologyCard
          title={processedData.approach.methodology.title}
          description={processedData.approach.methodology.description}
          points={processedData.approach.methodology.points}
          icon="academic"
          color="blue"
        />

        <MethodologyCard
          title={processedData.facilities.title}
          description={processedData.facilities.description}
          points={[
            "Săli de clasă moderne și confortabile",
            "Materiale didactice de ultimă generație",
            "Tehnologie educațională interactivă",
            "Spații de relaxare pentru pauze"
          ]}
          icon="puzzle"
          color="purple"
        />
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-16 bg-gradient-to-b from-indigo-50 to-white">
    <div class="container mx-auto px-4">
      <SectionTitle
        title={processedData.team.title}
        description="Cunoaște echipa noastră de profesori dedicați și pasionați de educație."
        badge="Echipa Noastră"
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {processedData.team.members.map((member: any, index: number) => {
          const colors = ['blue', 'purple', 'pink', 'green', 'yellow'] as const;
          return (
            <TeamMemberCard
              name={member.name}
              position={member.position}
              description={member.description}
              color={colors[index % colors.length]}
              social={{
                twitter: '#',
                linkedin: '#',
                facebook: '#'
              }}
            />
          );
        })}
      </div>
    </div>
  </section>

  <!-- Join Us Section -->
  <section class="py-16 bg-gradient-to-b from-white to-blue-50 relative overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-blue-200 rounded-full opacity-20"></div>
      <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-purple-200 rounded-full opacity-20"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-xl p-12 border border-blue-100">
        <SectionTitle
          title="Alătură-te comunității noastre!"
          description="Suntem mai mult decât o școală de limbă engleză - suntem o comunitate de învățare unde fiecare elev este important."
          badge="Înscrie-te acum"
          centered={true}
        />

        <div class="flex flex-wrap justify-center gap-6 mt-8">
          <a href="/classes" class="inline-block px-8 py-4 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition-colors shadow-md hover:shadow-lg">
            Vezi cursurile noastre
          </a>
          <a href="/contact" class="inline-block px-8 py-4 bg-white text-blue-600 border-2 border-blue-600 rounded-lg font-semibold hover:bg-blue-50 transition-colors shadow-sm hover:shadow-md">
            Contactează-ne
          </a>
        </div>
      </div>
    </div>
  </section>

  <ContactCTA data={processedData.contactCTA} />
</Layout>

<style>
  .animate-blob {
    animation: blob-bounce 7s infinite;
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  .animation-delay-4000 {
    animation-delay: 4s;
  }

  @keyframes blob-bounce {
    0% {
      transform: translate(0px, 0px) scale(1);
    }
    33% {
      transform: translate(30px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
    100% {
      transform: translate(0px, 0px) scale(1);
    }
  }
</style>