---
interface Props {
  title: string;
  fact: string;
  icon?: string;
  color?: 'blue' | 'pink' | 'purple' | 'green' | 'yellow';
}

const { 
  title, 
  fact, 
  icon = 'lightbulb', 
  color = 'blue' 
} = Astro.props;

const getColorClasses = (color: string) => {
  const colors = {
    blue: {
      bg: 'bg-blue-500',
      light: 'bg-blue-100',
      text: 'text-blue-600',
      gradient: 'from-blue-400 to-indigo-500'
    },
    pink: {
      bg: 'bg-pink-500',
      light: 'bg-pink-100',
      text: 'text-pink-600',
      gradient: 'from-pink-400 to-rose-500'
    },
    purple: {
      bg: 'bg-purple-500',
      light: 'bg-purple-100',
      text: 'text-purple-600',
      gradient: 'from-purple-400 to-indigo-500'
    },
    green: {
      bg: 'bg-green-500',
      light: 'bg-green-100',
      text: 'text-green-600',
      gradient: 'from-green-400 to-teal-500'
    },
    yellow: {
      bg: 'bg-yellow-500',
      light: 'bg-yellow-100',
      text: 'text-yellow-600',
      gradient: 'from-yellow-400 to-amber-500'
    }
  };
  
  return colors[color] || colors.blue;
};

const getIcon = (icon: string) => {
  const icons = {
    lightbulb: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
    star: 'M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z',
    rocket: 'M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z',
    fire: 'M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z',
    emoji: 'M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
  };
  
  return icons[icon] || icons.lightbulb;
};

const colorClasses = getColorClasses(color);
const iconPath = getIcon(icon);
---

<div class="relative group">
  <div class="absolute -inset-1 bg-gradient-to-r opacity-50 group-hover:opacity-100 transition duration-300 blur-md rounded-xl"></div>
  <div class="relative bg-white p-6 rounded-xl shadow-lg overflow-hidden">
    <!-- Decorative corner -->
    <div class={`absolute top-0 right-0 w-16 h-16 bg-gradient-to-br ${colorClasses.gradient} transform translate-x-8 -translate-y-8 rotate-45`}></div>
    
    <div class="flex items-start relative z-10">
      <div class={`p-3 ${colorClasses.light} rounded-lg mr-4 flex-shrink-0`}>
        <svg xmlns="http://www.w3.org/2000/svg" class={`h-6 w-6 ${colorClasses.text}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d={iconPath} />
        </svg>
      </div>
      <div>
        <h3 class="text-xl font-bold mb-2 text-gray-800">{title}</h3>
        <p class="text-gray-600">{fact}</p>
      </div>
    </div>
  </div>
</div>
