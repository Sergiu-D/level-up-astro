---
interface Props {
  text: string;
  color?: 'blue' | 'indigo' | 'pink' | 'green' | 'purple';
  animated?: boolean;
}

const { 
  text, 
  color = 'blue',
  animated = false 
} = Astro.props;

const colorClasses = {
  blue: 'bg-blue-100 text-blue-700',
  indigo: 'bg-indigo-100 text-indigo-700',
  pink: 'bg-pink-100 text-pink-700',
  green: 'bg-green-100 text-green-700',
  purple: 'bg-purple-100 text-purple-700'
};

const animationClass = animated ? 'animate-bounce' : '';
---

<div
  class={`inline-block rounded-full px-4 py-2 font-semibold text-sm mb-4 ${colorClasses[color]} ${animationClass}`}
>
  {text}
</div>
