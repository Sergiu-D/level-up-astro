---
interface Props {
  title: string;
  description: string;
  points: string[];
  icon?: string;
  color?: 'blue' | 'pink' | 'purple' | 'green' | 'yellow';
}

const { 
  title, 
  description, 
  points,
  icon = 'academic',
  color = 'blue'
} = Astro.props;

const getColorClasses = (color: string) => {
  const colors = {
    blue: {
      bg: 'bg-blue-500',
      light: 'bg-blue-50',
      text: 'text-blue-600',
      border: 'border-blue-200',
      accent: 'bg-blue-100'
    },
    pink: {
      bg: 'bg-pink-500',
      light: 'bg-pink-50',
      text: 'text-pink-600',
      border: 'border-pink-200',
      accent: 'bg-pink-100'
    },
    purple: {
      bg: 'bg-purple-500',
      light: 'bg-purple-50',
      text: 'text-purple-600',
      border: 'border-purple-200',
      accent: 'bg-purple-100'
    },
    green: {
      bg: 'bg-green-500',
      light: 'bg-green-50',
      text: 'text-green-600',
      border: 'border-green-200',
      accent: 'bg-green-100'
    },
    yellow: {
      bg: 'bg-yellow-500',
      light: 'bg-yellow-50',
      text: 'text-yellow-600',
      border: 'border-yellow-200',
      accent: 'bg-yellow-100'
    }
  };
  
  return colors[color] || colors.blue;
};

const getIcon = (icon: string) => {
  const icons = {
    academic: 'M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222',
    book: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
    puzzle: 'M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z',
    beaker: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
    chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z'
  };
  
  return icons[icon] || icons.academic;
};

const colorClasses = getColorClasses(color);
const iconPath = getIcon(icon);
---

<div class={`rounded-xl overflow-hidden border ${colorClasses.border} bg-white shadow-lg hover:shadow-xl transition-all duration-300`}>
  <div class={`p-6 ${colorClasses.light}`}>
    <div class="flex items-center mb-4">
      <div class={`p-3 rounded-lg mr-4 ${colorClasses.accent}`}>
        <svg xmlns="http://www.w3.org/2000/svg" class={`h-6 w-6 ${colorClasses.text}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d={iconPath} />
        </svg>
      </div>
      <h3 class="text-xl font-bold text-gray-800">{title}</h3>
    </div>
    <p class="mb-6 text-gray-600">{description}</p>
  </div>
  
  <div class="p-6 border-t border-gray-100">
    <ul class="space-y-3">
      {points.map(point => (
        <li class="flex items-start">
          <svg xmlns="http://www.w3.org/2000/svg" class={`h-5 w-5 ${colorClasses.text} mt-0.5 mr-2 flex-shrink-0`} viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span class="text-gray-700">{point}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
