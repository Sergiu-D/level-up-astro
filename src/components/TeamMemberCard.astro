---
interface Props {
  name: string;
  position: string;
  description: string;
  image?: string;
  color?: 'blue' | 'pink' | 'purple' | 'green' | 'yellow';
  social?: {
    twitter?: string;
    linkedin?: string;
    facebook?: string;
  };
}

const { 
  name, 
  position, 
  description, 
  image,
  color = 'blue',
  social = {}
} = Astro.props;

const getColorClasses = (color: string) => {
  const colors = {
    blue: {
      bg: 'bg-blue-500',
      light: 'bg-blue-100',
      gradient: 'from-blue-400 to-indigo-500',
      border: 'border-blue-200'
    },
    pink: {
      bg: 'bg-pink-500',
      light: 'bg-pink-100',
      gradient: 'from-pink-400 to-rose-500',
      border: 'border-pink-200'
    },
    purple: {
      bg: 'bg-purple-500',
      light: 'bg-purple-100',
      gradient: 'from-purple-400 to-indigo-500',
      border: 'border-purple-200'
    },
    green: {
      bg: 'bg-green-500',
      light: 'bg-green-100',
      gradient: 'from-green-400 to-teal-500',
      border: 'border-green-200'
    },
    yellow: {
      bg: 'bg-yellow-500',
      light: 'bg-yellow-100',
      gradient: 'from-yellow-400 to-amber-500',
      border: 'border-yellow-200'
    }
  };
  
  return colors[color] || colors.blue;
};

const colorClasses = getColorClasses(color);
const hasImage = !!image;
const hasSocial = Object.values(social).some(Boolean);
---

<div class="group">
  <div class="relative overflow-hidden rounded-xl shadow-lg transition-all duration-300 hover:shadow-xl bg-white border border-gray-100 transform group-hover:-translate-y-2">
    <!-- Colored top bar -->
    <div class={`h-3 bg-gradient-to-r ${colorClasses.gradient}`}></div>
    
    <div class="p-6">
      <!-- Profile image or placeholder -->
      {hasImage ? (
        <img 
          src={image} 
          alt={name} 
          class="w-32 h-32 rounded-full mx-auto mb-4 border-4 border-white shadow-md object-cover"
        />
      ) : (
        <div class={`w-32 h-32 rounded-full mx-auto mb-4 flex items-center justify-center ${colorClasses.gradient} text-white text-4xl font-bold shadow-md`}>
          {name.charAt(0)}
        </div>
      )}
      
      <!-- Content -->
      <div class="text-center">
        <h3 class="text-xl font-bold text-gray-800 mb-1">{name}</h3>
        <p class={`inline-block px-3 py-1 rounded-full text-sm font-medium mb-3 ${colorClasses.light} text-gray-700`}>
          {position}
        </p>
        <p class="text-gray-600 mb-4">{description}</p>
        
        <!-- Social links -->
        {hasSocial && (
          <div class="flex justify-center space-x-3 mt-4">
            {social.twitter && (
              <a href={social.twitter} class="text-gray-400 hover:text-blue-500 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path>
                </svg>
              </a>
            )}
            
            {social.linkedin && (
              <a href={social.linkedin} class="text-gray-400 hover:text-blue-700 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
                </svg>
              </a>
            )}
            
            {social.facebook && (
              <a href={social.facebook} class="text-gray-400 hover:text-blue-600 transition-colors">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"></path>
                </svg>
              </a>
            )}
          </div>
        )}
      </div>
    </div>
    
    <!-- Bottom decoration -->
    <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gray-200 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
  </div>
</div>
